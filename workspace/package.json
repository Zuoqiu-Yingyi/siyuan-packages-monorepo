{
    "name": "workspace",
    "type": "module",
    "private": true,
    "packageManager": "pnpm@12.3.4+sha512.961aa41fb077da3a04a441d9f8e15ebc0c96da8ef710b2eb67bf9ee7cb0610eabd48f1fd85f51cffe73846785fa0f87c56a3a872a1d893f8446741b5cce45457",
    "devEngines": {
        "runtime": {
            "name": "node",
            "version": "^26.8.1",
            "onFail": "download"
        }
    },
    "author": {
        "name": "Zuoqiu Yingyi",
        "url": "https://github.com/Zuoqiu-Yingyi"
    },
    "license": "AGPL-3.0-or-later",
    "repository": "https://github.com/Zuoqiu-Yingyi/siyuan-plugins-dev",
    "scripts": {
        "submodule:batch": "nu ./../scripts/git-submodule/batch.nu",
        "submodule:update": "git submodule update --init --recursive",
        "submodule:push": "git push --recurse-submodules=on-demand",
        "prepare": "cd ./.. && husky ./workspace/.husky",
        "lint-staged": "lint-staged --config lint-staged.config.js --allow-empty",
        "lint-staged:write": "lint-staged --config lint-staged.write.config.js --allow-empty",
        "outdated:all": "nu ./scripts/outdated.nu",
        "update:all": "nu ./scripts/update.nu",
        "prune:all": "nu ./scripts/prune.nu",
        "build": "turbo run build",
        "build:dev": "turbo run build:dev",
        "dev": "turbo run dev",
        "lint": "turbo run lint",
        "format": "turbo run format"
    },
    "dependencies": {
        "@siyuan-community/siyuan-sdk": "^0.3.17",
        "@workspace/eslint-config-custom": "workspace:*",
        "@workspace/tsconfig": "workspace:*",
        "@workspace/types": "workspace:*",
        "siyuan": "^1.2.7"
    },
    "devDependencies": {
        "@arco-design/web-vue": "^2.58.0",
        "@arco-plugins/vite-vue": "^1.4.6",
        "@sveltejs/vite-plugin-svelte": "^7.3.0",
        "@tsconfig/svelte": "^5.0.8",
        "@types/node": "^26.5.0",
        "@vitejs/plugin-vue": "^6.0.8",
        "deepmerge": "^4.3.1",
        "eslint": "^10.10.0",
        "husky": "^9.1.7",
        "less": "^4.9.1",
        "lint-staged": "^17.5.0",
        "npm-run-all": "^4.1.5",
        "prettier": "^3.9.6",
        "svelte": "^5.57.0",
        "svelte-check": "^4.7.6",
        "svelte-preprocess": "^6.0.5",
        "tslib": "^2.8.1",
        "tsx": "^4.23.13",
        "turbo": "^2.10.12",
        "typescript": "^6.0.3",
        "vite": "^8.2.2",
        "vite-plugin-static-copy": "^4.1.1",
        "vue": "^3.5.42",
        "vue-i18n": "^11.4.10"
    }
}
